\documentclass[11pt,letterpaper]{extarticle}

% ---------- Packages ----------
\usepackage[top=0.7in,bottom=0.7in,left=0.9in,right=0.9in]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{xcolor}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage{microtype}
\usepackage{etoolbox}

% ---------- Hyperlink colors ----------
\hypersetup{
  colorlinks=true,
  urlcolor=black,
  linkcolor=black,
  citecolor=black,
}

\pagestyle{plain}
\setlength{\parindent}{0pt}
\setlength{\parskip}{2pt}

% ---------- Section formatting ----------
\titleformat{\section}
  {\normalfont\large\bfseries\MakeUppercase}
  {}{0em}{}
  [\vspace{2pt}\hrule height 0.4pt\relax]
\titlespacing*{\section}{0pt}{12pt}{6pt}

% ---------- List formatting ----------
\setlist[itemize]{
  leftmargin=1.4em,
  labelsep=0.5em,
  itemsep=1pt,
  parsep=0pt,
  topsep=2pt,
  partopsep=0pt,
  label=\small$\bullet$
}

% ---------- Entry macros ----------
% parbox-based layout: left column holds title/org (wraps if too long),
% right column holds date. Prevents title/date collisions when the title
% is longer than the text width (e.g. long paper titles in Publications).
\newcommand{\entry}[4]{%
  \par\vspace{3pt}%
  \noindent\begin{minipage}[t]{0.68\textwidth}\raggedright\textbf{#1}\end{minipage}%
  \hfill\begin{minipage}[t]{0.3\textwidth}\raggedleft\textit{#2}\end{minipage}\par
  \ifstrempty{#3}{%
    \ifstrempty{#4}{}{\noindent\hfill #4\par}%
  }{%
    \noindent\begin{minipage}[t]{0.68\textwidth}\raggedright\textit{#3}\end{minipage}%
    \ifstrempty{#4}{}{\hfill\begin{minipage}[t]{0.3\textwidth}\raggedleft #4\end{minipage}}\par
  }%
}

\newcommand{\projentry}[2]{%
  \par\vspace{3pt}%
  \noindent\begin{minipage}[t]{0.68\textwidth}\raggedright\textbf{#1}\end{minipage}%
  \hfill\begin{minipage}[t]{0.3\textwidth}\raggedleft\textit{#2}\end{minipage}\par
}

% ---------- CV header ----------
\newcommand{\cvheader}{%
  \begin{center}
    {\LARGE\bfseries <<= data.personal.name =>>}\\[5pt]
    \small
    \href{mailto:<<= data.personal.email =>>}{<<= data.personal.email =>>}
    \;$\cdot$\;
    \href{<<= data.personal.website_url =>>}{<<= data.personal.website_label =>>}
    \;$\cdot$\;
    <<= data.personal.location =>>
    \\[2pt]
    \href{<<= data.personal.linkedin_url =>>}{<<= data.personal.linkedin_label =>>}
    \;$\cdot$\;
    \href{<<= data.personal.github_url =>>}{<<= data.personal.github_label =>>}
  \end{center}
  \vspace{2pt}
}

% =====================================================================
\begin{document}
\cvheader

% ---------- EDUCATION ----------
\section{Education}
<% for edu in data.education | only(target) %>
\entry{<<= edu.institution =>>}{<<= edu.dates =>>}{<<= edu.get('degree', '') =>>}{<<= edu.get('detail', '') =>>}
<% if edu.get('coursework') %>
\begin{itemize}
  \item \textbf{<<= edu.coursework.label =>>:} <<= edu.coursework.text =>><% if edu.coursework.get('suffix') %>\;\;{\small <<= edu.coursework.suffix =>>}<% endif %>
\end{itemize}
<% endif %>
<% endfor %>

% ---------- RESEARCH & PROFESSIONAL EXPERIENCE ----------
\section{Research and Professional Experience}
<% for exp in data.experience | only(target) %>
\entry{<<= exp.title =>>}{<<= exp.dates =>>}{<<= exp.get('org', '') =>>}{<<= exp.get('location', '') =>>}
<% set exp_bullets = exp.get('bullets', []) | only(target) %>
<% if exp_bullets %>
\begin{itemize}
<% for b in exp_bullets %>
  \item <<= b.text =>>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>

% ---------- PUBLICATIONS ----------
<% set pubs = data.projects | only(target) | with_venue %>
<% if pubs %>
\section{Publications}
<% for proj in pubs %>
\projentry{<<= proj.title =>>}{<<= proj.dates =>>}
\begin{itemize}
<% for b in proj.get('bullets', []) | only(target) %>
  \item <<= b.text =>>
<% endfor %>
  \item \textit{<<= proj.venue =>>}.<% if proj.get('doi') %>\\ \href{https://doi.org/<<= proj.doi =>>}{doi:<<= proj.doi =>>}<% endif %>
\end{itemize}
<% endfor %>
<% endif %>

% ---------- PROJECTS (unpublished / ongoing / coursework) ----------
<% set unpub = data.projects | only(target) | without_venue %>
<% if unpub %>
\section{Projects}
<% for proj in unpub %>
\projentry{<<= proj.title =>>}{<<= proj.dates =>>}
<% set proj_bullets = proj.get('bullets', []) | only(target) %>
<% if proj_bullets %>
\begin{itemize}
<% for b in proj_bullets %>
  \item <<= b.text =>>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>
<% endif %>

% ---------- PRESENTATIONS & POSTERS ----------
<% set pres = data.get('presentations', []) | only(target) %>
<% if pres %>
\section{Presentations and Posters}
<% for p in pres %>
\par\vspace{2pt}%
\noindent\textbf{<<= p.get('kind', 'Talk') =>>: <<= p.title =>>}\hfill\textit{<<= p.date =>>}\par
\noindent\textit{<<= p.venue =>>}\par
<% endfor %>
<% endif %>

% ---------- AWARDS & FELLOWSHIPS ----------
<% set aw = data.get('awards', []) | only(target) %>
<% if aw %>
\section{Awards and Fellowships}
\begin{itemize}
<% for a in aw %>
  \item \textbf{<<= a.name =>>} \hfill \textit{<<= a.date =>>}<% if a.get('note') %>\\ \small <<= a.note =>><% endif %>
<% endfor %>
\end{itemize}
<% endif %>

% ---------- SKILLS ----------
\section{Technical Skills and Languages}
\noindent\textbf{Technical:} <<= data.skills.technical =>>.\par
\noindent\textbf{Languages:} <<= data.skills.languages =>>.

\end{document}
