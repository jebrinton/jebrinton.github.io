\documentclass[10pt,letterpaper]{extarticle}

% ---------- Packages ----------
\usepackage[top=0.4in,bottom=0.35in,left=0.55in,right=0.55in]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{xcolor}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage{microtype}
\usepackage{etoolbox}
% NOTE: two-column hybrid via `multicol` was tried and overflowed to a 2nd
% page at current content volume (narrow-column bullet wrapping costs ~40%
% more vertical space). Reverted to single-column until bullets are
% tightened (MARS / AISA / Noisy rewrites pending). To try again, re-add
% `\usepackage{multicol}` and wrap Experience + Projects with
% `\begin{multicols}{2} ... \columnbreak ... \end{multicols}`.

% ---------- Hyperlink colors ----------
\hypersetup{
  colorlinks=true,
  urlcolor=black,
  linkcolor=black,
  citecolor=black,
}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ---------- Section formatting ----------
\titleformat{\section}
  {\normalfont\large\bfseries\MakeUppercase}
  {}{0em}{}
  [\vspace{1pt}\hrule height 0.4pt\relax]
\titlespacing*{\section}{0pt}{5pt}{2pt}

% ---------- List formatting ----------
\setlist[itemize]{
  leftmargin=1.2em,
  labelsep=0.45em,
  itemsep=0pt,
  parsep=0pt,
  topsep=0pt,
  partopsep=0pt,
  label=\small$\bullet$
}

% ---------- Entry macros ----------
\newcommand{\entry}[4]{%
  \par\vspace{1pt}%
  \noindent\textbf{#1}\hfill\textit{#2}\par
  \ifstrempty{#3}{%
    \ifstrempty{#4}{}{\noindent\hfill #4\par}%
  }{%
    \noindent\textit{#3}\ifstrempty{#4}{}{\hfill #4}\par
  }%
}

\newcommand{\projentry}[2]{%
  \par\vspace{1pt}%
  \noindent\textbf{#1}\hfill\textit{#2}\par
}

% ---------- Header ----------
\newcommand{\resumeheader}{%
  \begin{center}
    {\LARGE\bfseries <<= data.personal.name =>>}\\[3pt]
    \small
    \href{mailto:<<= data.personal.email =>>}{<<= data.personal.email =>>}
    \;$\cdot$\;
    \href{<<= data.personal.website_url =>>}{<<= data.personal.website_label =>>}
    \;$\cdot$\;
    <<= data.personal.location =>>
    \\[1pt]
    \href{<<= data.personal.linkedin_url =>>}{<<= data.personal.linkedin_label =>>}
    \;$\cdot$\;
    \href{<<= data.personal.github_url =>>}{<<= data.personal.github_label =>>}
  \end{center}
  \vspace{-4pt}
}

% =====================================================================
\begin{document}
\resumeheader

% ---------- EDUCATION (full width) ----------
\section{Education}

<% for edu in data.education | only(target) %>
<# When an education entry has no degree but has both a detail (e.g. "GPA: 4.0")
   and coursework, render the detail inline with the coursework bullet to save
   a line. This is USU-specific today; if another no-degree school appears with
   a long coursework string, revisit — the \hfill may push \small suffix off. #>
<% set inline_detail = edu.get('coursework') and not edu.get('degree') and edu.get('detail') %>
\entry{<<= edu.institution =>>}{<<= edu.dates =>>}{<<= edu.get('degree', '') =>>}{<% if not inline_detail %><<= edu.get('detail', '') =>><% endif %>}
<% if edu.get('coursework') %>
\begin{itemize}
  \item \textbf{<<= edu.coursework.label =>>:} <<= edu.coursework.text =>><% if edu.coursework.get('suffix') %>\;\;{\small <<= edu.coursework.suffix =>>}<% endif %><% if inline_detail %>\hfill <<= edu.detail =>><% endif %>
\end{itemize}
<% endif %>
<% endfor %>

% ---------- EXPERIENCE ----------
\section{Experience}
<% for exp in data.experience | only(target) %>
\entry{<<= exp.title =>>}{<<= exp.dates =>>}{<<= exp.get('org', '') =>>}{<<= exp.get('location', '') =>>}
<% set exp_bullets = exp.get('bullets', []) | only(target) %>
<% if exp_bullets %>
\begin{itemize}
<% for b in exp_bullets %>
  \item <<= b.text =>>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>

% ---------- PROJECTS & PUBLICATIONS ----------
\section{Projects \& Publications}
<% for proj in data.projects | only(target) %>
\projentry{<<= proj.title =>>}{<<= proj.dates =>>}
<% if proj.get('venue') %>
\noindent\textit{<% if proj.get('doi') %>\href{https://doi.org/<<= proj.doi =>>}{<<= proj.venue =>>}<% else %><<= proj.venue =>><% endif %>}.\par
<% endif %>
<% set proj_bullets = proj.get('bullets', []) | only(target) %>
<% if proj_bullets %>
\begin{itemize}
<% for b in proj_bullets %>
  \item <<= b.text =>>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>

% ---------- SKILLS (full width) ----------
\section{Skills}

\par\vspace{1pt}%
\noindent\textbf{Technical:} <<= data.skills.technical =>>.\par
\noindent\textbf{Languages:} <<= data.skills.languages =>>.

\end{document}
