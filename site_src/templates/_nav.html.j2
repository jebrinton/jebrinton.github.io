{# Nav partial. root_path is ../ for pages in the blog directory. #}
<nav class="nav" id="site-nav" role="navigation" aria-label="Main navigation">
  <a href="{{ root_path | default('') }}index.html" class="nav__home">Jacob Brinton</a>
  <ul class="nav__links" id="nav-links" role="list">
    <li><a href="{{ root_path | default('') }}index.html"{% if active == "home" %} class="active"{% endif %}>Home</a></li>
    <li><a href="{{ root_path | default('') }}about.html"{% if active == "about" %} class="active"{% endif %}>About</a></li>
    <li><a href="{{ root_path | default('') }}blog.html"{% if active == "blog" %} class="active" aria-current="page"{% endif %}>Blog</a></li>
    <li><a href="{{ root_path | default('') }}travels.html"{% if active == "travels" %} class="active"{% endif %}>Travels</a></li>
    <li><a href="{{ root_path | default('') }}offline.html"{% if active == "offline" %} class="active"{% endif %}>Offline</a></li>
    <li><a href="{{ root_path | default('') }}resume.html"{% if active == "resume" %} class="active"{% endif %}>Resume</a></li>
  </ul>
  <button class="nav__hamburger" aria-label="Toggle menu" aria-expanded="false"
          onclick="var n=document.getElementById('site-nav');n.classList.toggle('nav--open');this.setAttribute('aria-expanded',n.classList.contains('nav--open'))">
    <span></span><span></span><span></span>
  </button>
</nav>
